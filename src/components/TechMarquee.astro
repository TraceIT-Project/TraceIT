---
import Icon from "./Icon.astro";
import { TECH } from "../data/site";

const items = [...TECH.frontend, ...TECH.backend, ...TECH.datos, ...TECH.cloud];
---

<div class="marquee">
  <div class="marquee__track">
    {[false, true].map((duplicate) => (
      <ul class="marquee__group" aria-hidden={duplicate ? "true" : undefined}>
        {items.map((t) => (
          <li class="marquee__item"><Icon name={t.icon} brand={t.brand} />{t.name}</li>
        ))}
      </ul>
    ))}
  </div>
</div>
