---
import Icon from "./Icon.astro";
import TechStack from "./TechStack.astro";

const principles = [
  ["shield-check", "Tecnologías consolidadas", "Herramientas maduras, con soporte a largo plazo y una gran comunidad detrás."],
  ["puzzle", "Elegidas para tu caso", "Partimos de tus sistemas actuales y elegimos lo que mejor encaja con ellos."],
  ["file-text", "Sin ataduras", "Código documentado y estándar: cualquier equipo podrá mantenerlo."],
];
---

<section class="section" id="tecnologias" aria-labelledby="tecnologias-title">
  <div class="container tech-layout">
    <div class="sticky-head" data-reveal>
      <p class="eyebrow">Tecnologías</p>
      <h2 class="h2" id="tecnologias-title">Tecnología estándar, sin ataduras</h2>
      <p class="lead">Trabajamos con las tecnologías más consolidadas del mercado para que tu software sea fiable hoy y fácil de mantener mañana.</p>
      <ul class="principles">
        {principles.map(([icon, title, text]) => (
          <li><span class="icon-box"><Icon name={icon} /></span><div><strong>{title}</strong><p>{text}</p></div></li>
        ))}
      </ul>
    </div>
    <TechStack />
  </div>
</section>
