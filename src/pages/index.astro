---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import TraceMark from "../components/TraceMark.astro";
import TechMarquee from "../components/TechMarquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Sectors from "../components/Sectors.astro";
import equipo from "../assets/photos/equipo-escritorio.jpg";

const featured = (await getCollection("proyectos", (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const pains = [
  ["Los datos están repartidos en diez Excel y nadie se fía de las cifras.", "Un dashboard con una única fuente de datos, que se actualiza solo."],
  ["Tu equipo pierde horas copiando información de un programa a otro.", "Integraciones que conectan tus herramientas y eliminan el trabajo manual."],
  ["El programa de gestión tiene quince años y nadie se atreve a tocarlo.", "Lo modernizamos por fases, sin parar vuestro día a día."],
  ["Cada departamento usa su herramienta y la información no fluye.", "Una intranet que reúne personas, documentos y procesos en un solo sitio."],
  ["Ningún programa del mercado encaja con cómo trabajáis.", "Software diseñado alrededor de tus procesos, no al revés."],
];

const steps = [
  ["Escuchamos", "Reunión inicial gratuita para entender tu negocio y tu reto."],
  ["Proponemos", "Alcance, plan por fases y presupuesto cerrado por escrito."],
  ["Diseñamos", "Un prototipo navegable que validas antes de programar."],
  ["Desarrollamos", "Entregas parciales al ritmo que acordemos contigo."],
  ["Evolucionamos", "Puesta en marcha, formación y mantenimiento."],
];

const features = [
  ["key-round", "El código es tuyo", "Al terminar recibes el código fuente, la documentación y los accesos. Sin licencias por usuario ni ataduras."],
  ["receipt", "Presupuesto cerrado por fases", "Sabes qué pagas y qué recibes en cada entrega. Sin sorpresas en la factura."],
  ["repeat", "Entregas a tu medida", "Acordamos contigo el ritmo de entregas y pruebas el software mientras se construye, en un entorno de pruebas propio."],
  ["pen-tool", "Prototipo antes de programar", "Validas pantallas y flujos con tu equipo antes de escribir una línea de código."],
  ["life-buoy", "Contigo después de la entrega", "Planes de mantenimiento con actualizaciones de seguridad, copias, soporte y mejoras."],
  ["globe", "En remoto, en España y Latinoamérica", "Trabajamos con empresas de toda España y Latinoamérica, con reuniones por videollamada y herramientas compartidas."],
];

const faqs = [
  ["¿Cuánto cuesta un software a medida?", "Depende del alcance: no es lo mismo conectar dos programas que construir una plataforma con varios perfiles de usuario. Tras una primera reunión gratuita, analizamos tu caso y te enviamos un presupuesto cerrado por fases, para que sepas exactamente qué pagas y qué recibes en cada entrega."],
  ["¿Cuánto tarda en estar listo?", "Depende del proyecto, pero no tienes que esperar al final para verlo: acordamos contigo un calendario de entregas a tu medida y, en cada una, te enseñamos lo construido para que lo pruebes. En la propuesta inicial te damos el calendario por fases."],
  ["¿De quién es el código?", "Tuyo. Al terminar te entregamos el código fuente, la documentación y todos los accesos. Sin licencias por usuario ni dependencias que te aten a nosotros."],
  ["¿Podéis mejorar un programa que ya tenemos?", "Sí. Auditamos lo que tienes, te recomendamos si conviene evolucionarlo o sustituirlo por partes, y lo modernizamos por fases sin parar vuestro día a día."],
  ["¿Se puede conectar con nuestro ERP, CRM u otras herramientas?", "En la mayoría de los casos, sí: mediante API, acceso a base de datos o intercambio automático de ficheros. Lo comprobamos en la fase de análisis, antes de comprometer nada."],
  ["¿Qué pasa después de la entrega?", "Formamos a tu equipo y te ofrecemos planes de mantenimiento: actualizaciones de seguridad, copias de seguridad, soporte y nuevas funcionalidades cuando las necesites. Si lo prefieres, también con una bolsa de horas mensual."],
  ["¿Y si no sé exactamente lo que necesito?", "Es lo más habitual. Para eso está la consultoría inicial: entendemos tu proceso, te proponemos la solución más sencilla que funcione y la validamos con un prototipo navegable antes de desarrollar."],
  ["¿Trabajáis con empresas de fuera de Málaga?", "Sí. Trabajamos en remoto con empresas de toda España y Latinoamérica, con reuniones por videollamada. Y si estás en Málaga, Granada o Almería, también podemos reunirnos en persona cuando haga falta."],
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};

const uptime = Array.from({ length: 45 }, (_, i) => i === 27);
const bars = [38, 52, 44, 66, 58, 78, 70, 92];
---

<Base
  title="TraceIT · Desarrollo de software a medida para empresas en Málaga"
  description="Diseñamos y desarrollamos software a medida para empresas: aplicaciones web y móviles, intranets, dashboards e integraciones. Y mejoramos el software que ya tienes. Desde Málaga, en remoto para España y Latinoamérica."
  active="inicio"
  jsonLd={[faqLd]}
>
  <!-- ============ HERO ============ -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="bg-glow"></div><div class="bg-grid"></div>
    <TraceMark />
    <div class="container">
      <div class="hero__grid">
        <div class="hero__copy">
          <h1 class="h1 hero__title" id="hero-title" data-intro style="--i:1">Tu empresa trabaja a su manera. <span class="hl">Tu software también debería.</span></h1>
          <p class="lead hero__lead" data-intro style="--i:2">Diseñamos y desarrollamos aplicaciones web y móviles, intranets, dashboards e integraciones hechas para tus procesos, y mejoramos el software que ya tienes. De la primera idea a producción, con un equipo que habla tu idioma.</p>
          <div class="hero__actions" data-intro style="--i:3">
            <a class="btn btn--primary" href="/contacto/">Cuéntanos tu proyecto <Icon name="arrow-right" /></a>
            <a class="btn btn--ghost" href="/proyectos/">Ver proyectos</a>
          </div>
        </div>

        <div class="mock" data-tilt data-intro style="--i:3" aria-hidden="true">
          <div class="mock__win">
            <div class="mock__bar">
              <span class="mock__dots"><i></i><i></i><i></i></span>
              <span class="mock__url"><Icon name="lock" /> intranet.tuempresa.es/operaciones</span>
            </div>
            <div class="mock__body">
              <div class="mock__side">
                <span class="mock__app"><img src="/img/simbolo-light.svg" alt="" width="18" height="15" />Operaciones</span>
                <span class="mock__nav is-active"><Icon name="layout-dashboard" />Panel</span>
                <span class="mock__nav"><Icon name="package" />Pedidos</span>
                <span class="mock__nav"><Icon name="truck" />Rutas</span>
                <span class="mock__nav"><Icon name="users" />Clientes</span>
                <span class="mock__nav"><Icon name="file-text" />Informes</span>
                <span class="mock__nav"><Icon name="cable" />Integraciones</span>
              </div>
              <div class="mock__main">
                <div class="mock__head"><strong>Panel de operaciones</strong><span>Hoy · 09:41</span></div>
                <div class="mock__kpis">
                  <div class="kpi"><small>Pedidos hoy</small><b data-count="1284">1.284</b><em>▲ 12,4 %</em></div>
                  <div class="kpi"><small>Entregas a tiempo</small><b data-count="97.8" data-decimals="1" data-suffix=" %">97,8 %</b><em>▲ 3,1 pts</em></div>
                  <div class="kpi"><small>Horas ahorradas/mes</small><b data-count="312">312</b><em>▲ automatizado</em></div>
                </div>
                <div class="mock__chart">
                  <div class="mock__chart-head"><span>Pedidos por hora</span><span class="mock__legend"><span><i></i>Hoy</span><span><i></i>Semana pasada</span></span></div>
                  <svg viewBox="0 0 300 110" preserveAspectRatio="none">
                    <defs><linearGradient id="area-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2fd0bc" stop-opacity=".35"></stop><stop offset="1" stop-color="#2fd0bc" stop-opacity="0"></stop></linearGradient></defs>
                    <path class="chart-grid" d="M0 27.5H300M0 55H300M0 82.5H300"></path>
                    <path class="chart-prev" d="M0 90 C20 86 35 82 50 79 S80 72 100 74 S130 63 150 65 S185 55 200 58 S235 49 250 51 S285 44 300 45"></path>
                    <path class="chart-area" fill="url(#area-grad)" d="M0 94 C20 88 35 72 50 74 S80 60 100 62 S130 40 150 46 S185 32 200 36 S235 20 250 24 S285 12 300 14 V110 H0 Z"></path>
                    <path class="chart-line" pathLength="1" d="M0 94 C20 88 35 72 50 74 S80 60 100 62 S130 40 150 46 S185 32 200 36 S235 20 250 24 S285 12 300 14"></path>
                  </svg>
                </div>
                <div class="mock__rows">
                  <div class="mock__row"><code>#24071</code><span>Almacén Norte → Sevilla</span><span class="status status--ok">En ruta</span></div>
                  <div class="mock__row"><code>#24068</code><span>Almacén Sur → Granada</span><span class="status status--info">Preparando</span></div>
                  <div class="mock__row"><code>#24063</code><span>Almacén Norte → Córdoba</span><span class="status status--mute">Entregado</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="mock__float mock__float--a"><div class="float-card"><span class="float-card__icon"><Icon name="refresh-cw" /></span><span>Sincronizado con el ERP<small>hace 2 minutos</small></span></div></div>
          <div class="mock__float mock__float--b"><div class="float-card"><span class="float-card__icon"><Icon name="file-text" /></span><span>Informe mensual generado<small>Enviado a dirección · PDF</small></span></div></div>
          <div class="mock__float mock__float--c"><div class="float-card"><svg class="donut" viewBox="0 0 36 36"><circle class="track" cx="18" cy="18" r="15.9155"></circle><circle class="val" cx="18" cy="18" r="15.9155" pathLength="100"></circle></svg><span>68 % de procesos<small>automatizados</small></span></div></div>
        </div>
      </div>

      <div class="tech-strip">
        <p class="tech-strip__label">Tecnologías con<br />las que trabajamos</p>
        <TechMarquee />
      </div>
    </div>
  </section>

  <!-- ============ PROBLEMAS / SOLUCIONES ============ -->
  <section class="section" id="retos" aria-labelledby="retos-title">
    <div class="container pains">
      <div class="sticky-head" data-reveal>
        <p class="eyebrow"><span class="num">01</span> Qué resolvemos</p>
        <h2 class="h2" id="retos-title">¿Te suena alguna de estas situaciones?</h2>
        <p class="lead">Son las que más escuchamos en la primera reunión. Todas tienen solución, y casi nunca pasa por añadir otra herramienta más.</p>
        <a class="link-arrow" href="/contacto/">Cuéntanos la tuya <Icon name="arrow-right" /></a>
      </div>
      <ol class="pains__list" data-stagger>
        {pains.map(([before, after], i) => (
          <li class="pain">
            <span class="pain__num">{String(i + 1).padStart(2, "0")}</span>
            <p class="pain__before"><span>{before}</span></p>
            <p class="pain__after"><Icon name="check" /> {after}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  <section class="section section--soft" id="servicios" aria-labelledby="servicios-title">
    <div class="container">
      <div class="sec-head sec-head--split" data-reveal>
        <p class="eyebrow"><span class="num">02</span> Servicios</p>
        <h2 class="h2" id="servicios-title">Software a medida para cada parte de tu negocio</h2>
        <div class="sec-head__side">
          <p class="lead">Desde una integración puntual hasta una plataforma completa, pasando por la consultoría previa. Empezamos por lo que más impacto tiene y crecemos contigo.</p>
          <a class="link-arrow" href="/servicios/">Ver todos los servicios <Icon name="arrow-right" /></a>
        </div>
      </div>

      <div class="bento" data-stagger>
        <article class="card card--wide span-4 spot">
          <div class="card__text">
            <span class="icon-box"><Icon name="monitor-smartphone" /></span>
            <h3>Aplicaciones web y móviles a medida</h3>
            <p>Herramientas de gestión, portales para clientes y apps diseñadas alrededor de tus procesos. Seguras, rápidas y fáciles de usar desde cualquier dispositivo.</p>
            <a class="link-arrow card__link" href="/servicios/#aplicaciones-web">Saber más <Icon name="arrow-right" /></a>
          </div>
          <div class="viz viz-app" aria-hidden="true">
            <div class="viz-app__bar"><i></i><i></i><i></i></div>
            <div class="viz-app__body">
              <div class="viz-app__side"><span class="sk sk--navy sk--w70"></span><span class="sk sk--w85"></span><span class="sk sk--w55"></span><span class="sk sk--w70"></span><span class="sk sk--w40"></span></div>
              <div class="viz-app__main">
                <span class="sk sk--navy sk--w40"></span>
                <div class="viz-app__cards">
                  <span><span class="sk sk--w55"></span><span class="sk sk--teal sk--w85"></span></span>
                  <span><span class="sk sk--w40"></span><span class="sk sk--navy sk--w70"></span></span>
                  <span><span class="sk sk--w55"></span><span class="sk sk--w85"></span></span>
                </div>
                <div class="viz-app__table">
                  <span><i class="sk"></i><i class="sk sk--w85"></i><i class="sk sk--w55"></i></span>
                  <span class="is-hl"><i class="sk sk--teal"></i><i class="sk sk--w70"></i><i class="sk sk--w40"></i></span>
                  <span><i class="sk"></i><i class="sk sk--w85"></i><i class="sk sk--w55"></i></span>
                  <span><i class="sk"></i><i class="sk sk--w55"></i><i class="sk sk--w70"></i></span>
                </div>
              </div>
            </div>
            <svg class="viz-app__cursor" viewBox="0 0 24 24"><path d="M5 3l6.5 17 2.4-7.1L21 10.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          </div>
        </article>

        <article class="card span-2 spot">
          <span class="icon-box"><Icon name="building-2" /></span>
          <h3>Intranets y portales de empleado</h3>
          <p>Comunicación interna, documentos, vacaciones y aprobaciones en un único lugar.</p>
          <ul class="chips"><li class="chip">Documentos</li><li class="chip">Vacaciones</li><li class="chip">Aprobaciones</li></ul>
          <a class="link-arrow card__link" href="/servicios/#intranets">Saber más <Icon name="arrow-right" /></a>
        </article>

        <article class="card span-2 spot">
          <span class="icon-box"><Icon name="chart-no-axes-combined" /></span>
          <h3>Dashboards y cuadros de mando</h3>
          <p>Indicadores en tiempo real conectados a tu ERP, CRM, Excel o bases de datos.</p>
          <div class="viz-bars" aria-hidden="true">
            {bars.map((h, k) => <span style={`--h:${h}%;--k:${k}`}></span>)}
          </div>
          <a class="link-arrow card__link" href="/servicios/#dashboards">Saber más <Icon name="arrow-right" /></a>
        </article>

        <article class="card span-2 spot">
          <span class="icon-box"><Icon name="workflow" /></span>
          <h3>Integraciones y automatización</h3>
          <p>Conectamos tus herramientas para que los datos fluyan solos entre ellas.</p>
          <div class="viz-flow" aria-hidden="true">
            <svg viewBox="0 0 300 108">
              <path class="wire" d="M62 21C92 21 92 54 122 54M62 87C92 87 92 54 122 54M178 54C196 54 196 21 214 21M178 54C196 54 196 87 214 87"></path>
              <path class="pulse" pathLength="100" d="M62 21C92 21 92 54 122 54"></path>
              <path class="pulse" pathLength="100" d="M62 87C92 87 92 54 122 54"></path>
              <path class="pulse" pathLength="100" d="M178 54C196 54 196 21 214 21"></path>
              <g class="node"><rect x="6" y="8" width="56" height="26" rx="7"></rect><text x="34" y="25">ERP</text></g>
              <g class="node"><rect x="6" y="74" width="56" height="26" rx="7"></rect><text x="34" y="91">CRM</text></g>
              <g class="hub"><rect x="122" y="38" width="56" height="32" rx="9"></rect><image href="/img/simbolo-light.svg" x="138" y="44" width="24" height="20"></image></g>
              <g class="node"><rect x="214" y="8" width="80" height="26" rx="7"></rect><text x="254" y="25">Facturación</text></g>
              <g class="node"><rect x="214" y="74" width="80" height="26" rx="7"></rect><text x="254" y="91">Tienda online</text></g>
            </svg>
          </div>
          <a class="link-arrow card__link" href="/servicios/#integraciones">Saber más <Icon name="arrow-right" /></a>
        </article>

        <article class="card span-2 spot">
          <span class="icon-box"><Icon name="history" /></span>
          <h3>Modernización de software</h3>
          <p>Evolucionamos o sustituimos por fases ese programa antiguo del que depende tu negocio.</p>
          <div class="viz-legacy" aria-hidden="true">
            <div class="viz-legacy__old"><span>Access · VB6</span><span>Excel con macros</span></div>
            <Icon name="arrow-right" />
            <div class="viz-legacy__new"><span>Web moderna</span><span>API + nube</span></div>
          </div>
          <a class="link-arrow card__link" href="/servicios/#modernizacion">Saber más <Icon name="arrow-right" /></a>
        </article>

        <article class="card card--wide span-6 spot">
          <div class="card__text">
            <span class="icon-box"><Icon name="life-buoy" /></span>
            <h3>Mantenimiento y evolución</h3>
            <p>Tu software siempre al día: actualizaciones de seguridad, copias de seguridad, soporte y nuevas funcionalidades cuando las necesites. También con bolsa de horas mensual.</p>
            <a class="link-arrow card__link" href="/servicios/#mantenimiento">Saber más <Icon name="arrow-right" /></a>
          </div>
          <div class="viz viz-status" aria-hidden="true">
            <div class="viz-status__head"><span>Todos los sistemas operativos</span><small>Últimos 90 días</small></div>
            <div class="uptime">{uptime.map((warn) => <i class={warn ? "warn" : undefined}></i>)}</div>
            <ul class="viz-status__list">
              <li><Icon name="shield-check" /> Actualizaciones de seguridad</li>
              <li><Icon name="database" /> Copias de seguridad</li>
              <li><Icon name="life-buoy" /> Soporte y mejoras</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ PROYECTOS ============ -->
  <section class="section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="container">
      <div class="sec-head sec-head--split" data-reveal>
        <p class="eyebrow"><span class="num">03</span> Proyectos</p>
        <h2 class="h2" id="proyectos-title">Software que ya funciona en empresas como la tuya</h2>
        <div class="sec-head__side">
          <p class="lead">Algunos de los proyectos que hemos desarrollado para empresas de distintos sectores: retos reales, soluciones a medida y resultados que se notan en el día a día.</p>
          <a class="link-arrow" href="/proyectos/">Ver todos los proyectos <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="projects-feature">
        {featured.map((project, i) => (
          <ProjectCard project={project} index={i} desc={i === 0} ratio={i === 0 ? [4, 5] : [16, 10]} sizes={i === 0 ? "(max-width: 960px) calc(100vw - 40px), (max-width: 1340px) 54vw, 680px" : "(max-width: 960px) calc(100vw - 40px), (max-width: 1340px) 44vw, 540px"} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESO (resumen) ============ -->
  <section class="section on-dark" id="proceso" aria-labelledby="proceso-title">
    <div class="container">
      <div class="sec-head sec-head--split" data-reveal>
        <p class="eyebrow"><span class="num">04</span> Cómo trabajamos</p>
        <h2 class="h2" id="proceso-title">Un proceso claro, de la primera idea a producción</h2>
        <div class="sec-head__side">
          <p class="lead">Sabes en todo momento qué estamos haciendo, cuánto cuesta y qué vas a recibir. Sin cajas negras.</p>
          <a class="btn btn--ghost" href="/como-trabajamos/">Ver cómo trabajamos <Icon name="arrow-right" /></a>
        </div>
      </div>
      <ol class="steps-row" data-stagger>
        {steps.map(([title, text], i) => (
          <li class="step-mini">
            <span class="step-mini__node" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ SECTORES ============ -->
  <Sectors num="05" />

  <!-- ============ POR QUÉ ============ -->
  <section class="section" id="por-que" aria-labelledby="porque-title">
    <div class="container why">
      <div class="why__media" data-reveal>
        <div class="why__frame">
          <Image src={equipo} alt="Dos desarrolladores revisando código juntos en una oficina luminosa" widths={[640, 960, 1400]} sizes="(max-width: 960px) calc(100vw - 40px), (max-width: 1340px) 40vw, 520px" quality={72} />
        </div>
        <div class="glass-badge">
          <p><strong>La primera reunión es gratuita.</strong><br />Cuéntanos tu caso y te diremos, sin compromiso, cómo lo resolveríamos.</p>
          <p class="glass-badge__row"><Icon name="clock" /> Respondemos en menos de 24 horas</p>
        </div>
      </div>
      <div>
        <div class="sec-head sec-head--flush" data-reveal>
          <p class="eyebrow"><span class="num">06</span> Por qué TraceIT</p>
          <h2 class="h2" id="porque-title">Un socio tecnológico, no un proveedor más</h2>
          <p class="lead">Estas son las reglas con las que trabajamos en cada proyecto, sea grande o pequeño.</p>
        </div>
        <div class="features" data-stagger>
          {features.map(([icon, title, text]) => (
            <div class="feature"><span class="icon-box"><Icon name={icon} /></span><h3>{title}</h3><p>{text}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section--soft" id="faq" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="sticky-head" data-reveal>
        <p class="eyebrow"><span class="num">07</span> Preguntas frecuentes</p>
        <h2 class="h2" id="faq-title">Lo que suelen preguntarnos</h2>
        <div class="help-card">
          <p><strong>¿Tienes otra duda?</strong><br />Escríbenos y te respondemos en menos de 24 horas.</p>
          <a class="link-arrow" href="/contacto/">Contactar <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="faq__list" data-reveal>
        {faqs.map(([q, a], i) => (
          <details name="faq" open={i === 0}>
            <summary>{q}<span class="faq__icon" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
